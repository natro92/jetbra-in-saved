import asyncio, json, os, sys, time, socket, urllib.request, urllib.error

STREAM_READ_SIZE = int(os.environ.get("STREAM_READ_SIZE", "16"))

B_HOST = sys.argv[1] if len(sys.argv) > 1 else os.environ.get("B_HOST", "47.112.209.75")
B_PORT = int(os.environ.get("B_PORT", "18888"))
MIMO_API_KEY = os.environ.get("MIMO_API_KEY", "")
MIMO_API_ENDPOINT = os.environ.get("MIMO_API_ENDPOINT", "")
MIMO_BASE_URL = os.environ.get("MIMO_BASE_URL", "https://aistudio.xiaomimimo.com").rstrip("/")
MIMO_SERVICE_TOKEN = os.environ.get("MIMO_SERVICE_TOKEN", "")
MIMO_USER_ID = os.environ.get("MIMO_USER_ID", "")
MIMO_PH = os.environ.get("MIMO_PH", "")
MODEL = os.environ.get("MODEL", "mimo-v2.5-pro")
RESTART_INTERVAL = int(os.environ.get("RESTART_INTERVAL", "3600"))
CONNECT_TIMEOUT = int(os.environ.get("CONNECT_TIMEOUT", "15"))
READ_TIMEOUT = int(os.environ.get("READ_TIMEOUT", "180"))
HEARTBEAT_INTERVAL = int(os.environ.get("HEARTBEAT_INTERVAL", "20"))
MAX_BACKOFF = int(os.environ.get("MAX_BACKOFF", "30"))
DEFAULT_ENDPOINT = f"{MIMO_BASE_URL}/api/chat/completions"

if not MIMO_API_ENDPOINT:
    MIMO_API_ENDPOINT = DEFAULT_ENDPOINT

endpoint_lower = MIMO_API_ENDPOINT.lower()
if "127.0.0.1" in endpoint_lower or "localhost" in endpoint_lower:
    print(f"[WARN] ignore local MIMO_API_ENDPOINT={MIMO_API_ENDPOINT}; fallback to {DEFAULT_ENDPOINT}")
    MIMO_API_ENDPOINT = DEFAULT_ENDPOINT

if MIMO_API_KEY.strip().lower() == "relay":
    print("[WARN] ignore relay placeholder MIMO_API_KEY")
    MIMO_API_KEY = ""

if not (MIMO_API_KEY or (MIMO_SERVICE_TOKEN and MIMO_USER_ID)):
    print("need MIMO_API_KEY or cookie env (MIMO_SERVICE_TOKEN + MIMO_USER_ID)")
    sys.exit(1)

async def send(writer, obj):
    writer.write((json.dumps(obj, ensure_ascii=False) + "\n").encode())
    await writer.drain()

def build_headers():
    headers = {"Content-Type": "application/json"}
    if MIMO_SERVICE_TOKEN and MIMO_USER_ID:
        cookie_parts = [f"serviceToken={MIMO_SERVICE_TOKEN}", f"userId={MIMO_USER_ID}"]
        if MIMO_PH:
            cookie_parts.append(f"xiaomichatbot_ph={MIMO_PH}")
        headers["Cookie"] = "; ".join(cookie_parts)
    elif MIMO_API_KEY:
        headers["Authorization"] = f"Bearer {MIMO_API_KEY}"
    return headers


def open_api(body):
    body = dict(body or {})
    req_model = body.get("model")
    if not req_model or req_model == "relay":
        body["model"] = MODEL
    req = urllib.request.Request(
        MIMO_API_ENDPOINT,
        data=json.dumps(body).encode(),
        headers=build_headers(),
        method="POST",
    )
    resp = urllib.request.urlopen(req, timeout=READ_TIMEOUT)
    reader = resp.read
    try:
        fp = getattr(resp, "fp", None)
        raw = getattr(fp, "raw", None) if fp is not None else None
        sock = getattr(raw, "_sock", None) if raw is not None else None
        if sock is not None:
            sock.settimeout(READ_TIMEOUT)
            try:
                sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
            except Exception:
                pass
        if raw is not None:
            if hasattr(raw, "read1"):
                reader = raw.read1
            elif hasattr(raw, "read"):
                reader = raw.read
    except Exception:
        pass
    return resp, body.get("stream"), reader

async def process(msg, writer):
    req_id, body = msg.get("id"), msg.get("body", {})
    try:
        resp, stream, reader = await asyncio.to_thread(open_api, body)
        try:
            if stream:
                had_output = False
                pending = b""
                while True:
                    try:
                        chunk = await asyncio.to_thread(reader, STREAM_READ_SIZE)
                    except socket.timeout:
                        if had_output:
                            print(f"[WARN] stream read timeout after partial output, force end req_id={req_id}")
                            break
                        raise
                    if not chunk:
                        break
                    had_output = True
                    pending += chunk
                    while True:
                        nl = pending.find(b"\n")
                        if nl < 0:
                            break
                        line = pending[:nl]
                        pending = pending[nl + 1:]
                        s = line.decode("utf-8", errors="replace").rstrip("\r")
                        if s:
                            await send(writer, {"id": req_id, "event": "line", "data": s})
                            if s.startswith("data:") and s[5:].strip() == "[DONE]":
                                pending = b""
                                break
                    else:
                        continue
                    break
                if pending:
                    s = pending.decode("utf-8", errors="replace").rstrip("\r\n")
                    if s:
                        await send(writer, {"id": req_id, "event": "line", "data": s})
            else:
                text = (await asyncio.to_thread(resp.read)).decode("utf-8", errors="replace")
                await send(writer, {"id": req_id, "event": "body", "data": text})
        finally:
            resp.close()
        await send(writer, {"id": req_id, "event": "end"})
    except urllib.error.HTTPError as e:
        await send(writer, {"id": req_id, "event": "error", "message": e.read().decode("utf-8", errors="replace")[:1000]})
    except Exception as e:
        await send(writer, {"id": req_id, "event": "error", "message": str(e)})

async def heartbeat(writer):
    while True:
        await asyncio.sleep(HEARTBEAT_INTERVAL)
        await send(writer, {"event": "heartbeat", "ts": time.time()})

async def handle(reader, writer):
    buf, tasks = "", set()
    await send(writer, {"event": "hello", "ts": time.time(), "pid": os.getpid()})
    hb = asyncio.create_task(heartbeat(writer))
    try:
        while True:
            data = await reader.read(4096)
            if not data:
                break
            buf += data.decode("utf-8", errors="replace")
            lines = buf.split("\n")
            buf = lines.pop()
            for line in lines:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                    if msg.get("event") == "request":
                        t = asyncio.create_task(process(msg, writer))
                        tasks.add(t)
                        t.add_done_callback(tasks.discard)
                except Exception:
                    pass
    finally:
        hb.cancel()
        if tasks:
            await asyncio.gather(*tasks, return_exceptions=True)
        writer.close()
        await writer.wait_closed()

async def connect_loop():
    backoff = 1
    while True:
        try:
            reader, writer = await asyncio.wait_for(asyncio.open_connection(B_HOST, B_PORT), timeout=CONNECT_TIMEOUT)
            backoff = 1
            await handle(reader, writer)
        except Exception as e:
            print("connect error:", e)
        await asyncio.sleep(backoff)
        backoff = min(backoff * 2, MAX_BACKOFF)

async def restart_timer():
    await asyncio.sleep(RESTART_INTERVAL)
    os.execv(sys.executable, [sys.executable] + sys.argv)

async def main():
    await asyncio.gather(connect_loop(), restart_timer())

if __name__ == "__main__":
    asyncio.run(main())
